From 79917896fea6d85bc38e5a52cf8a0c03c2d38c82 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 04:02:20 +0000
Subject: [PATCH] fix(gitops): count a role granted to allUsers for the picked
 identity (BYT-10423)

Step 2 of the GitOps setup reported "no role" and disabled Continue for a
workload identity whose role comes from an allUsers binding, although the
server authorizes it. The role check now counts a binding that names the
identity or allUsers, as the server's permission check does: allUsers in the
project always, allUsers in the workspace except on Bytebase Cloud.
---
 docs/design/gitops-setup-page.md              |  6 +-
 .../routes/project/ProjectGitOpsPage.test.tsx | 59 ++++++++++++++++++-
 .../routes/project/gitops-setup/identity.ts   | 36 +++++++----
 3 files changed, 88 insertions(+), 13 deletions(-)

diff --git a/docs/design/gitops-setup-page.md b/docs/design/gitops-setup-page.md
index e987e8a..8fd0901 100644
--- a/docs/design/gitops-setup-page.md
+++ b/docs/design/gitops-setup-page.md
@@ -288,7 +288,9 @@ Resolves part 2.
     because opened from setup it does not offer Other OIDC (D10).
   - The identity has a role that allows GitOps in this project, such as GitOps Service Agent. An
     identity with no role cannot review or deploy, so Continue is disabled and a warning links to
-    the Members page.
+    the Members page. A role granted to `allUsers` counts, as in the server's permission check
+    (`backend/component/iam/manager.go`): always in the project, and in the workspace except on
+    Bytebase Cloud.
 - *Goes into the files:* the identity's email and its git provider.
 - *Not asked:* git provider, owner, repository, owner ID, email, role, issuer and audience. The
   identity already holds them.
@@ -600,6 +602,8 @@ Tests:
 - `ProjectGitOpsPage.test.tsx`:
   - A project with one database and no identity opens on the Databases tab with the database picked.
   - Continue is disabled with nothing picked, and with an identity that has no role.
+  - A role granted to `allUsers` counts for the identity: in the project always, in the workspace
+    except on Bytebase Cloud.
   - The scope line shows on every step.
   - An identity for another OIDC provider cannot be picked.
   - The Create dialog opens with GitHub Actions and GitLab CI only.
diff --git a/frontend/src/routes/project/ProjectGitOpsPage.test.tsx b/frontend/src/routes/project/ProjectGitOpsPage.test.tsx
index f192691..741ca7b 100644
--- a/frontend/src/routes/project/ProjectGitOpsPage.test.tsx
+++ b/frontend/src/routes/project/ProjectGitOpsPage.test.tsx
@@ -75,6 +75,8 @@ const mocks = vi.hoisted(() => {
     identitiesByName: {} as Record<string, WorkloadIdentity>,
     // Members that hold a role in the project.
     members: [] as string[],
+    // Bytebase Cloud.
+    saas: false,
   };
   const store = {
     fetchDBGroupListByProjectName: vi.fn(async () => state.groups),
@@ -90,7 +92,8 @@ const mocks = vi.hoisted(() => {
     fetchWorkloadIdentity: vi.fn(async () => undefined),
     getWorkloadIdentity: (name: string) => state.identitiesByName[name],
     projectPoliciesByName: {} as Record<string, unknown>,
-    workspacePolicy: undefined,
