+      to={{
+        name: PROJECT_V1_ROUTE_DATABASE_GROUP_DETAIL,
+        params: { projectId, databaseGroupName },
+      }}
+      className={linkClass}
+    >
+      {t("gitops.setup.databases.view-group")}
+    </RouterLink>
+  );
+}
