+++ b/frontend/src/routes/project/gitops-setup/DeployOrder.test.tsx
@@ -0,0 +1,127 @@
+import { create } from "@bufbuild/protobuf";
+import { act, type ReactNode } from "react";
+import { createRoot } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import {
+  type Database,
+  DatabaseSchema$,
+} from "@/types/proto-es/v1/database_service_pb";
+import { DeployOrder } from "./DeployOrder";
+import type { DeployTargets } from "./useDeployTargets";
+
+(
+  globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }
+).IS_REACT_ACT_ENVIRONMENT = true;
+
+vi.mock("react-i18next", () => ({
+  initReactI18next: { type: "3rdParty", init: () => {} },
+  useTranslation: () => ({
+    t: (key: string, options?: Record<string, unknown>) =>
+      options ? `${key} ${JSON.stringify(options)}` : key,
+  }),
+}));
+
+vi.mock("@/components/DatabaseTargetDisplay", () => ({
+  DatabaseTargetDisplay: ({ database }: { database: Database }) => (
+    <span data-testid="database">{database.name}</span>
+  ),
+}));
+
+vi.mock("@/components/EnvironmentLabel", () => ({
+  EnvironmentLabel: ({ environmentName }: { environmentName: string }) => (
+    <span data-testid="environment">{environmentName}</span>
+  ),
+}));
+
+vi.mock("@/components/ui/popover", () => ({
+  Popover: ({ children }: { children: ReactNode }) => <div>{children}</div>,
+  PopoverTrigger: ({ children }: { children: ReactNode }) => (
+    <button type="button" data-testid="more">
+      {children}
+    </button>
+  ),
+  PopoverContent: ({ children }: { children: ReactNode }) => (
+    <div data-testid="more-list">{children}</div>
+  ),
+}));
+
+const db = (name: string) =>
+  create(DatabaseSchema$, { name: `instances/pg/databases/${name}` });
+
+const many = (prefix: string, count: number) =>
+  Array.from({ length: count }, (_, i) => db(`${prefix}${i + 1}`));
+
+describe("DeployOrder", () => {
+  let container: HTMLDivElement;
+  let root: ReturnType<typeof createRoot>;
+
+  const render = (targets: DeployTargets) => {
+    act(() => root.render(<DeployOrder targets={targets} />));
+  };
+
+  beforeEach(() => {
+    container = document.createElement("div");
+    document.body.appendChild(container);
+    root = createRoot(container);
+  });
+
+  afterEach(() => {
+    act(() => root.unmount());
+    container.remove();
+  });
+
+  test("shows one section per environment in the given order", () => {
+    render({
+      stages: [
+        { environment: "environments/test", id: "test", databases: [db("t1")] },
+        { environment: "environments/prod", id: "prod", databases: [db("p1")] },
+      ],
+      unassigned: [],
+      total: 2,
+      loading: false,
+    });
+    const environments = [
+      ...container.querySelectorAll('[data-testid="environment"]'),
+    ].map((e) => e.textContent);
+    expect(environments).toEqual(["environments/test", "environments/prod"]);
+    // Two databases: no total line and no "+N more".
+    expect(container.textContent).not.toContain("gitops.setup.deploy-order.summary");
+    expect(container.querySelector('[data-testid="more"]')).toBeNull();
+  });
+
+  test("shows three chips, then +N more, and the total above three", () => {
+    render({
+      stages: [{ environment: "environments/prod", id: "prod", databases: many("p", 5) }],
+      unassigned: [],
+      total: 5,
+      loading: false,
+    });
+    const section = container.querySelector("li");
+    const chips = [
+      ...(section?.querySelectorAll('[data-testid="database"]') ?? []),
+    ].filter((e) => !e.closest('[data-testid="more-list"]'));
+    expect(chips.map((e) => e.textContent)).toEqual([
+      "instances/pg/databases/p1",
+      "instances/pg/databases/p2",
+      "instances/pg/databases/p3",
+    ]);
+    expect(container.querySelector('[data-testid="more"]')?.textContent).toBe(
+      'common.n-more {"n":2}'
+    );
+    expect(container.textContent).toContain("gitops.setup.deploy-order.summary");
+  });
+
+  test("warns about databases with no environment", () => {
+    render({
+      stages: [{ environment: "environments/prod", id: "prod", databases: [db("p1")] }],
+      unassigned: [db("old1"), db("old2")],
+      total: 3,
+      loading: false,
+    });
+    const alert = container.querySelector('[role="alert"]');
+    expect(alert?.textContent).toContain(
+      'gitops.setup.deploy-order.unassigned-title {"count":2}'
+    );
+    expect(alert?.textContent).toContain("instances/pg/databases/old2");
+  });
+});
diff --git a/frontend/src/routes/project/gitops-setup/DeployOrder.tsx b/frontend/src/routes/project/gitops-setup/DeployOrder.tsx
new file mode 100644
index 0000000..c7c36b0
--- /dev/null
+++ b/frontend/src/routes/project/gitops-setup/DeployOrder.tsx
@@ -0,0 +1,190 @@
+import { useMemo, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { DatabaseTargetDisplay } from "@/components/DatabaseTargetDisplay";
+import { EnvironmentLabel } from "@/components/EnvironmentLabel";
+import { Alert } from "@/components/ui/alert";
+import { Button } from "@/components/ui/button";
+import {
+  Popover,
+  PopoverContent,
+  PopoverTrigger,
+} from "@/components/ui/popover";
+import { SearchInput } from "@/components/ui/search-input";
+import { cn } from "@/lib/utils";
+import type { Database } from "@/types/proto-es/v1/database_service_pb";
+import { extractDatabaseResourceName } from "@/utils";
+import type { DeployTargets } from "./useDeployTargets";
+
+// Databases shown as chips before the "+N more" action, as on the plan page.
+export const VISIBLE_DATABASES = 3;
+// The "+N more" list gets a search box above this many databases.
+const SEARCHABLE_DATABASES = 20;
+
+// The picked databases in the order the deploy reaches them: one section per
+// environment, joined by a line, and a warning for databases with no
+// environment.
+export function DeployOrder({ targets }: { readonly targets: DeployTargets }) {
+  const { t } = useTranslation();
+  const { stages, unassigned, total } = targets;
+  return (
+    <div className="flex flex-col gap-y-3">
+      {stages.length > 0 && (
+        <div className="flex flex-col gap-y-2">
+          {total > VISIBLE_DATABASES && (
+            <p className="text-sm text-control-light">
+              {t("gitops.setup.deploy-order.summary", {
+                databases: t("gitops.setup.deploy-order.database-count", {
+                  count: total,
+                }),
+                environments: t("gitops.setup.deploy-order.environment-count", {
+                  count: stages.length,
+                }),
+              })}
+            </p>
+          )}
+          <ol
+            aria-label={t("gitops.setup.deploy-order.label")}
+            className="rounded-sm border border-block-border px-4 py-1"
+          >
+            {stages.map((stage, index) => (
+              <li
+                key={stage.environment}
+                className="relative flex flex-col gap-y-2 py-3 pl-8"
+              >
+                {index > 0 && (
+                  <span
+                    aria-hidden="true"
+                    className="absolute top-0 left-3 h-6 w-px -translate-x-1/2 bg-control-border"
+                  />
+                )}
+                {index < stages.length - 1 && (
+                  <span
+                    aria-hidden="true"
+                    className="absolute top-6 bottom-0 left-3 w-px -translate-x-1/2 bg-control-border"
+                  />
+                )}
+                <span
+                  aria-hidden="true"
+                  className="absolute top-6 left-3 size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-control-border bg-background"
+                />
+                <div className="flex h-6 items-center">
+                  <EnvironmentLabel environmentName={stage.environment} />
+                </div>
+                <DatabaseChips databases={stage.databases} />
+              </li>
+            ))}
+          </ol>
+        </div>
+      )}
+      {unassigned.length > 0 && (
+        <Alert
+          variant="warning"
+          title={t("gitops.setup.deploy-order.unassigned-title", {
+            count: unassigned.length,
+          })}
+          description={t("gitops.setup.deploy-order.unassigned-description", {
+            count: unassigned.length,
+          })}
+        >
+          <DatabaseChips className="mt-2" databases={unassigned} />
+        </Alert>
+      )}
+    </div>
+  );
+}
+
+export function DatabaseChips({
+  databases,
+  className,
+}: {
+  readonly databases: Database[];
+  readonly className?: string;
+}) {
+  const visible = databases.slice(0, VISIBLE_DATABASES);
+  const extra = databases.slice(VISIBLE_DATABASES);
+  return (
+    <div className={cn("flex min-w-0 flex-wrap items-center gap-2", className)}>
+      {visible.map((database) => (
+        <DatabaseChip key={database.name} database={database} />
+      ))}
+      {extra.length > 0 && <MoreDatabases databases={extra} />}
+    </div>
+  );
+}
+
+function DatabaseChip({ database }: { readonly database: Database }) {
+  return (
+    <div className="inline-flex max-w-full min-w-0 cursor-default items-center gap-x-1 rounded-sm border bg-control-bg/50 px-2 py-1">
+      <DatabaseTargetDisplay database={database} />
+    </div>
+  );
+}
+
+function MoreDatabases({ databases }: { readonly databases: Database[] }) {
+  const { t } = useTranslation();
+  const [searchText, setSearchText] = useState("");
+  const filtered = useMemo(() => {
+    const query = searchText.trim().toLowerCase();
+    if (!query) return databases;
+    return databases.filter(
+      (database) =>
+        extractDatabaseResourceName(database.name)
+          .databaseName.toLowerCase()
+          .includes(query) || database.name.toLowerCase().includes(query)
+    );
+  }, [databases, searchText]);
+  return (
+    <Popover>
+      <PopoverTrigger
+        render={
+          <Button
+            className="text-accent hover:bg-accent/10 hover:text-accent"
+            size="xs"
+            type="button"
+            appearance="secondary"
+          />
+        }
+      >
+        {t("common.n-more", { n: databases.length })}
+      </PopoverTrigger>
+      <PopoverContent
+        align="start"
+        className="w-[min(520px,calc(100vw-2rem))] p-0"
+        side="bottom"
+      >
+        <div className="border-b border-control-border px-3 py-2">
+          <div className="text-sm font-medium text-control">
+            {t("common.databases")} ({databases.length})
+          </div>
+        </div>
+        {databases.length > SEARCHABLE_DATABASES && (
+          <div className="border-b border-control-border px-3 py-2">
+            <SearchInput
+              placeholder={t("common.search")}
+              value={searchText}
+              onChange={(event) => setSearchText(event.target.value)}
+            />
+          </div>
+        )}
+        <div className="max-h-80 overflow-y-auto p-2">
+          {filtered.length > 0 ? (
+            <div className="flex flex-col gap-1">
+              {filtered.map((database) => (
+                <div
+                  key={database.name}
+                  className="min-w-0 rounded-xs px-2 py-1.5 hover:bg-control-bg"
+                >
+                  <DatabaseTargetDisplay database={database} />
+                </div>
+              ))}
+            </div>
+          ) : (
+            <div className="px-2 py-4 text-center text-sm text-control-light">
+              {t("common.no-data")}
+            </div>
+          )}
+        </div>
+      </PopoverContent>
+    </Popover>
+  );
+}
